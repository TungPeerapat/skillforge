{# Shared macros for generated SKILL.md bodies. #}

{% macro cmd_block(commands) -%}
```bash
{% for command in commands %}{{ command.command }}
{% endfor %}```
{%- endmacro %}

{% macro steps(steps) -%}
{% for step in steps %}{{ loop.index }}. `{{ step.command }}`
   - Where it comes from: `{{ step.provenance }}`
   - Risk: {{ step.risk_label }}{% if step.cwd not in ('.', '') %} · run from `{{ step.cwd }}`{% endif %}

{% endfor %}
{%- endmacro %}

{% macro guardrails(items) -%}
{% for item in items %}- {{ item }}
{% endfor %}
{%- endmacro %}

{% macro commands_table(commands) -%}
| Command | Purpose | Risk | Source |
| --- | --- | --- | --- |
{% for command in commands %}| `{{ command.command }}` | {{ command.purpose }} | {{ command.risk_label }} | `{{ command.provenance }}` |
{% endfor %}
{%- endmacro %}

{% macro services_section(services) -%}
{% set local_services = services | rejectattr('origin', 'equalto', 'ci') | list %}
{% if local_services %}
## Dependency services

| Service | Kind | Image | Ports |
| --- | --- | --- | --- |
{% for service in local_services %}| {{ service.name }} | {{ service.kind }} | `{{ service.image or '-' }}` | {{ service.ports | join(', ') or '-' }} |
{% endfor %}

{% endif %}
{%- endmacro %}

{% macro unknowns_section(unknowns) -%}
{% if unknowns %}
## Verify before assuming

These questions could not be answered from repository evidence. Confirm them before relying on them:

{% for unknown in unknowns %}- {{ unknown.question }}
{% if unknown.suggested_check %}  - Check: {{ unknown.suggested_check }}

{% endif %}{% if unknown.why %}  - Why unknown: {{ unknown.why }}

{% endif %}{% endfor %}
{% endif %}
{%- endmacro %}

{% macro scripts_section(scripts) -%}
{% if scripts %}
## Scripts

{% for script in scripts %}- `{{ script.path }}` — {{ script.description }}
{% endfor %}

Run them with the system Python; they use only the standard library:

```bash
python {{ scripts[0].path }} --help
```
{% endif %}
{%- endmacro %}

{% macro references_section(references) -%}
{% if references %}
## References

